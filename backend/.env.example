MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
JWT_SECRET_KEY=<random-64-char-hex-string>
GEOAPIFY_API_KEY=<geoapify-api-key>
PEXELS_API_KEY=<pexels-api-key>
OPENWEATHER_API_KEY=<openweathermap-api-key>
# RapidAPI key subscribed to "Xotelo - Hotel Prices" (Basic/free tier)
RAPIDAPI_KEY=<rapidapi-key>
# Free key from console.groq.com -- powers the RAG AI Assistant
GROQ_API_KEY=<groq-api-key>

# Comma-separated list of frontend origins allowed to call this API.
# Must be set to the real deployed frontend domain(s) in production.
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# "production" enables Secure+SameSite=None auth cookies (requires HTTPS).
# Leave unset/"development" for local HTTP development.
ENVIRONMENT=development
